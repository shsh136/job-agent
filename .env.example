# Copy this file to .env and fill in the values. Never share .env.

# Adzuna — free key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch — subscribe (free tier) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Gmail account that SENDS the digest. Use a 16-character App Password, not your normal password:
# Google Account -> Security -> 2-Step Verification (on) -> App passwords
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional: Claude API key for per-job analysis, tailored interview prep and cover letters.
# Get one at https://platform.claude.com/ . Without it the agent uses its built-in prep library.
ANTHROPIC_API_KEY=

# Free alternative: Google Gemini key from https://aistudio.google.com/apikey (used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=
